kb/output/extracted/
kb/output/extracted-bulk/
kb/output/raw/
kb/output/packs/
kb/output/firmware-genome/
kb/output-wip/
kb/output/staging/
kb/output/logs/
kb/output/validation-reports/
kb/output/INDEX.json
kb/output/final/
kb/output/scripts/

# Symlinks pointing to external disk (machine-specific)
kb-final
kb-pipeline
server
landing
hardware
firmware-templates

# === Logs ===
*.log
logs/
/tmp/*

# === Build artifacts ===
*.tar.gz
*.tar.zst
*.zip
*.7z
*.bin
*.hex
*.elf
*.o

# === Pytest artifacts ===
.pytest_cache/

# === Backups ===
*.bak
*~

# === Temp / scratch ===
scratch/
tmp/
.scratch/

# === Archive directory (kept locally, не пушим) ===
archive/

# === Internal agent briefs — kept locally, not in public repo ===
# These are AI prompt scaffolds with experimental scope notes.
# Public-facing scope lives in PRD.md and README.md.
agents/kimi/briefs/
agents/deepseek/briefs/
agents/claude/briefs/
agents/*/budget*.json

# === docs/ — legacy AI scaffolds, replaced by PRD.md + README.md ===
docs/KIMI-*.md
docs/PROMPTS.md
docs/TASKS.md
docs/REMAINING.md
docs/BRAND.md

# === Backward-compat symlink to KB final (lives elsewhere) ===
kb-final
