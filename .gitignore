.env.local
.env.*.local
*.key
*secret*
**/agents/*/budget*.json
**/agents/*/*.private.*

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
.eggs/
build/
dist/
*.egg

# === Node ===
node_modules/
package-lock.json
*.tgz

