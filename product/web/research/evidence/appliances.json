    "rules": [
      "Keep null for missing part numbers/revisions; a model-family relationship is not proof of identical chips.",
      "Store each forum post and edit separately; suggestions, measurements and final outcomes are distinct claims.",
      "OCR markings generate candidates. A reviewer compares image region against transcript and datasheet package before accepting.",
      "Datasheet establishes component specifications, never proves that component is on the donor board.",
      "Compatibility needs variant, voltage, pinout, signal protocol and physical dimensions; no generic has_5V therefore usable edge.",
      "Attach build readiness only to a BOM+firmware+schematic+test record, not a donor discovery.",
      "Non-isolated mains modules are expert-only analysis; beginner build routes use independent low-voltage modules.",
      "Retain original URL, author attribution and rights metadata; cache metadata/short quotations, not whole forums by default.",
      "Deduplicate exact hashes and board labels first. Never deduplicate only by appliance model.",
      "Keep failed hypotheses and contradictory observations searchable so a wrong forum answer does not become a recipe."
    ],
    "recommended_ui": [
      "Что можно получить: documented modules + confidence badge",
      "Что внутри: board photo + component hotspots + exact scope",
      "Что доказано: official document / original observation / tested build separately",
      "Что ещё нужно: firmware, driver, isolated power, calibration and test requirements",
      "Открыть первоисточник: exact post or PDF page"
    ],
    "example_searches": [
      "T55640 → PNC 91609628602 → board marking EVN SC70600245055 → owner-reported Omron relay",
      "EWX14 → photographed STM8S207RB → datasheet → firmware/configuration constraint",
      "12 V pump controller → compare complete tested builds; appliance relay is merely a candidate part"
    ]
  },
